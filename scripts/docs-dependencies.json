{
  "version": 1,
  "rules": [
    {
      "globs": [".agents/**", ".opencode/**"],
      "documents": [],
      "decision": "skip",
      "reason": "Configuração e kit local do OpenCode não integram o comportamento do aplicativo documentado."
    },
    {
      "globs": ["scraper_sici_nome.py", "atualizador_MFE.py", "area_negocio_ml.py", "calculadora_tercis.py", "config_manager.py", "config.txt"],
      "documents": ["docs/data-lineage.md", "docs/architecture.md"],
      "decision": "review_ai",
      "reason": "Fontes, extração, regras de classificação, transformações e planilhas do fluxo SICI/MFE."
    },
    {
      "globs": ["match_lideres.py", "gestores_equipes.py"],
      "documents": ["docs/data-lineage.md", "docs/architecture.md"],
      "decision": "review_ai",
      "reason": "Cruzamentos de lideranças e seus arquivos de entrada e saída."
    },
    {
      "globs": ["painel_principal.py", "gerar exe.txt", "requirements.txt"],
      "documents": ["docs/architecture.md", "docs/data-lineage.md"],
      "decision": "review_ai",
      "reason": "Orquestração, distribuição e dependências do aplicativo."
    },
    {
      "globs": ["MFE_Base.xlsx", "model_fjg.pkl", "vectorizer_fjg.pkl"],
      "documents": ["docs/data-lineage.md"],
      "decision": "manual_review",
      "reason": "Schemas de planilha e modelos binários exigem confirmação humana antes de documentar comportamento."
    },
    {
      "globs": ["mkdocs.yml", "requirements-docs.txt", "docs/**", "docs/assets/**", "docs/diagramas/**"],
      "documents": [],
      "decision": "regenerate",
      "reason": "Alterações na própria documentação ou na visualização exigem somente reconstrução e validação."
    }
  ]
}
