{
  "name": "@documentation-engineer/kit",
  "version": "0.1.0-beta.1",
  "description": "Kit de documentação para OpenCode: skill system-documentation e agente documentation-engineer (arquitetura, fluxo/linhagem de dados e regras de negócio, com MkDocs local privado e triagem Git incremental determinística).",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "documentation",
    "docs",
    "opencode",
    "agent",
    "skill",
    "mermaid",
    "mkdocs",
    "data-lineage",
    "architecture",
    "business-rules"
  ],
  "bin": {
    "documentation-engineer": "bin/documentation-engineer.js"
  },
  "scripts": {
    "postinstall": "node lib/installer.js install",
    "prepack": "node lib/clean.js",
    "test": "node test/selftest.js"
  },
  "files": [
    ".agents/",
    ".opencode/",
    "examples/",
    "bin/",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16"
  }
}
